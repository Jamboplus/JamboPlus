# Copy to railway.env and fill in (never commit railway.env)
# cp scripts/railway.env.example scripts/railway.env

# Optional: Railway project/service (skip interactive link)
# RAILWAY_PROJECT_ID=
# RAILWAY_SERVICE=

# Public API URL — auto-filled after first deploy if empty
# RAILWAY_PUBLIC_URL=https://jamboplus-api-production.up.railway.app

# Production secrets (auto-generated on first setup if empty)
JWT_SECRET=
APP_API_SECRET=
APP_API_KEY=jamboplus-prod-key
ADMIN_EMAIL=jamboplus@gmail.com
ADMIN_PASSWORD=Chundabadi6%

# Server env (Railway sets PORT automatically)
DB_PATH=/data/jamboad.db
HOST=0.0.0.0

# SonicPesa (required for live mobile-money payments)
SONICPESA_API_KEY=
SONICPESA_SECRET_KEY=
SONICPESA_WEBHOOK_SECRET=
# Webhook URL for SonicPesa dashboard:
# https://jamboplus-production.up.railway.app/v1/app/payments/sonicpesa/webhook

# Flutter release builds (optional — run ./scripts/deploy-railway.sh --build-apk)
# JAMBO_APP_SECRET must match APP_API_SECRET on the server
BUILD_RELEASE_APK=false
